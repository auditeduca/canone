{
  "name": "canone-backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Cânone — modelo de dados estrutural e metamodelo do Ecossistema de Provas para Contadores",
  "scripts": {
    "migrate": "node scripts/migrate.mjs",
    "migrate:reset": "node scripts/migrate.mjs --reset",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "pretest": "tsc",
    "test": "node --test \"tests/*.test.mjs\"",
    "db:reset": "node scripts/migrate.mjs --reset",
    "erd": "node scripts/gerar-erd.mjs",
    "contrato:comander": "npm run build && node scripts/gerar-contrato-comander.mjs",
    "comander": "node scripts/subir-comander.mjs",
    "comander:e2e": "npm run build && node scripts/prova-comander-e2e.mjs",
    "precos": "node scripts/gerar-precos.mjs",
    "meta:generate": "node integrations/metadata-auto/generate.mjs --write",
    "meta:check": "node integrations/metadata-auto/generate.mjs --check",
    "meta:test": "node --test integrations/metadata-auto/tests/*.test.mjs tests/12-audit-educa-bridge.test.mjs",
    "canonical:generate": "node integrations/canonical-knowledge/generate.mjs --write",
    "canonical:check": "node integrations/canonical-knowledge/generate.mjs --check",
    "canonical:test": "node --test integrations/canonical-knowledge/tests/*.test.mjs",
    "bridge:graph-check": "node integrations/metadata-auto/graph-gate.mjs",
    "corpus:readiness": "node integrations/canonical-corpus/readiness-cli.mjs",
    "corpus:test": "node --test integrations/canonical-corpus/tests/*.test.mjs",
    "corpus:archive": "node integrations/canonical-corpus/archive.mjs",
    "corpus:storage-index": "node integrations/canonical-corpus/export-storage-index.mjs",
    "corpus:recover-storage": "node integrations/canonical-corpus/recover-storage-triad.mjs",
    "corpus:review-batches": "node integrations/canonical-corpus/review-batches.mjs",
    "senado:dry-run": "node integrations/senado-legislacao/fetch-readonly.mjs",
    "senado:fetch": "node integrations/senado-legislacao/fetch-readonly.mjs --execute",
    "senado:test": "node --test integrations/senado-legislacao/tests/*.test.mjs",
    "senado:verify": "node integrations/senado-legislacao/fetch-readonly.mjs --verify",
    "senado:articles": "node integrations/senado-legislacao/article-queue.mjs --check",
    "senado:source-check": "node integrations/senado-legislacao/source-backed-review.mjs --check",
    "senado:source-generate": "node integrations/senado-legislacao/source-backed-review.mjs --write",
    "product:generate": "node contracts/product/generate.mjs --write",
    "product:check": "node contracts/product/generate.mjs --check",
    "product:test": "node --test contracts/product/tests/*.test.mjs",
    "shared-host:port-generate": "node db/shared-host/port-sql.mjs --write",
    "shared-host:port-check": "node db/shared-host/port-sql.mjs --check",
    "shared-host:test": "node --test db/shared-host/tests/*.test.mjs",
    "test:s9": "npm run build && node --test tests/14-acesso-api.test.mjs tests/15-s9-entitlement-portal.test.mjs tests/16-s9-account-revocation.test.mjs",
    "test:s10": "npm run build && node --test tests/14-acesso-api.test.mjs tests/15-s9-entitlement-portal.test.mjs tests/16-s9-account-revocation.test.mjs tests/17-s10-caderno-erros.test.mjs",
    "shared-host:s11-review": "node db/shared-host/s11-review-all.mjs --check",
    "shared-host:s11-qa": "S11_ALLOW_DISPOSABLE_PGLITE=1 node db/shared-host/s11-disposable-pglite-smoke.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  }
}

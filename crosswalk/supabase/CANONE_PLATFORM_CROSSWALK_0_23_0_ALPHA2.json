{
  "auth_identity": [
    {
      "detail": "Keep UUID as identity link, not a writable replica of auth.users.",
      "legacy": "identity.account.id",
      "strategy": "managed_identity_fk",
      "target": "auth.users.id"
    },
    {
      "detail": "Read through authorized server API or approved private RPC; no duplicate credential store.",
      "legacy": "identity.account.email",
      "strategy": "supabase_auth_managed",
      "target": "auth.users.email"
    },
    {
      "detail": "Never import passwords, password hashes, OTPs or magic-link tokens as rows.",
      "legacy": "identity.account.password_hash",
      "strategy": "retire_legacy_credential",
      "target": "Supabase Auth"
    },
    {
      "detail": "Account bans are controlled by Auth; student onboarding state belongs to app domain.",
      "legacy": "identity.account.status",
      "strategy": "split_auth_and_app_state",
      "target": "Supabase Auth + canone_identity.user_profile"
    },
    {
      "detail": "Application profile uses UUID FK to auth.users; no direct public grant on auth.users.",
      "legacy": "identity.user_profile.user_id",
      "strategy": "foreign_key",
      "target": "auth.users.id"
    },
    {
      "detail": "Server-enforced grant authority; never trust raw_user_meta_data or client-supplied role.",
      "legacy": "identity.user_role",
      "strategy": "protected_role_registry",
      "target": "canone_identity.user_role"
    },
    {
      "detail": "App-specific study sessions remain distinct from authentication sessions.",
      "legacy": "identity.session",
      "strategy": "replace_auth_runtime",
      "target": "Supabase Auth session"
    },
    {
      "detail": "Supabase Auth owns login token generation, expiry and redemption.",
      "legacy": "identity.magic_link",
      "strategy": "replace_auth_runtime",
      "target": "Supabase Auth OTP/magic link"
    },
    {
      "detail": "No client-writable current_user_id GUC may determine row ownership.",
      "legacy": "ops.current_user_id()",
      "strategy": "jwt_identity_in_rls",
      "target": "auth.uid()"
    },
    {
      "detail": "Use server-managed grants/roles with fresh DB check for sensitive writes.",
      "legacy": "ops.current_area() / ops.is_staff()",
      "strategy": "signed_roles_and_db_lookup",
      "target": "canone_identity.role grants and trusted JWT app_metadata"
    }
  ],
